#version 450
#extension GL_GOOGLE_include_directive : require
#include "bc7.glsl"
#include "bc6h.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint data[]; } src;
layout(set = 0, binding = 1, std430) writeonly buffer Destination { uint data[]; } dst;
layout(push_constant) uniform Region {
    uint mode; // 0..3: BC1 RGB/RGBA, BC2, BC3; 4..7: BC4/5 U/S; 8: packed RGB8; 9: BC7; 10/11: BC6H RGBA16F U/S; 12/13: packed RGB16F U/S
    uint source_word;
    uint row_blocks;
    uint layer_blocks;
    uint width;
    uint height;
    uint pixels;
    uint first_pixel;
    uint destination_word;
    uint chunk_pixels;
} r;

uvec3 rgb565(uint value)
{
    uvec3 c = uvec3(value >> 11, (value >> 5) & 63, value & 31);
    return (c << uvec3(3, 2, 3)) | (c >> uvec3(2, 4, 2));
}

uint color_rgba(uint word, uint within, uint mode)
{
    uint endpoints = src.data[word];
    uint c0 = endpoints & 65535, c1 = endpoints >> 16;
    uvec3 a = rgb565(c0), b = rgb565(c1), color;
    uint index = (src.data[word + 1] >> (within * 2)) & 3;
    uint alpha = 255;
    if (index == 0) color = a;
    else if (index == 1) color = b;
    else if (mode >= 2 || c0 > c1)
        color = index == 2 ? (2 * a + b) / 3 : (a + 2 * b) / 3;
    else if (index == 2) color = (a + b) / 2;
    else {
        color = uvec3(0);
        if (mode == 1) alpha = 0;
    }
    return color.r | (color.g << 8) | (color.b << 16) | (alpha << 24);
}

uint rgb8_texel(uint pixel)
{
    uint x = pixel % r.width, y = (pixel / r.width) % r.height;
    uint layer = pixel / (r.width * r.height);
    uint block = layer * r.layer_blocks + (y / 4) * r.row_blocks + x / 4;
    return color_rgba(r.source_word + block * 2, (y & 3) * 4 + (x & 3), 0) & 0xffffff;
}

uint index3(uint word, uint pixel)
{
    uint lo = src.data[word], hi = src.data[word + 1];
    uint bit = 16 + pixel * 3;
    uint index;
    if (bit < 32) {
        index = lo >> bit;
        // Only pixel 5 straddles words; never shift a 32-bit value by 32.
        if (bit == 31) index |= hi << 1;
    } else index = hi >> (bit - 32);
    return index & 7;
}

uint alpha3(uint word, uint pixel)
{
    uint lo = src.data[word];
    uint a = lo & 255, b = (lo >> 8) & 255;
    uint index = index3(word, pixel);
    if (index == 0) return a;
    if (index == 1) return b;
    if (a > b) return ((8 - index) * a + (index - 1) * b) / 7;
    if (index == 6) return 0;
    if (index == 7) return 255;
    return ((6 - index) * a + (index - 1) * b) / 5;
}

uint channel16(uint word, uint pixel, bool snorm)
{
    uint endpoints = src.data[word];
    int a = int(endpoints & 255), b = int((endpoints >> 8) & 255);
    int denominator = snorm ? 127 : 255;
    int scale = snorm ? 32767 : 65535;
    if (snorm) {
        a = max(a >= 128 ? a - 256 : a, -127);
        b = max(b >= 128 ? b - 256 : b, -127);
    }
    int index = int(index3(word, pixel));
    int numerator;
    if (index == 0) numerator = a;
    else if (index == 1) numerator = b;
    else if (a > b) {
        numerator = (8 - index) * a + (index - 1) * b;
        denominator *= 7;
    } else if (index == 6) return snorm ? uint(-32767) & 65535 : 0;
    else if (index == 7) return uint(scale);
    else {
        numerator = (6 - index) * a + (index - 1) * b;
        denominator *= 5;
    }
    // Quantize only once, after interpolation, to nearest UNORM16/SNORM16.
    // Signed -127/-128 endpoint ordering is implementation-defined; saturate
    // both before comparison. All arithmetic fits a signed 32-bit integer.
    int magnitude = (abs(numerator) * scale + denominator / 2) / denominator;
    return uint(numerator < 0 ? -magnitude : magnitude) & 65535;
}

uvec2 bc6_texel(uint pixel)
{
    uint x = pixel % r.width, y = (pixel / r.width) % r.height;
    uint layer = pixel / (r.width * r.height);
    uint block = layer * r.layer_blocks + (y / 4) * r.row_blocks + x / 4;
    uint word = r.source_word + block * 4;
    return bc6_rgba16(uvec4(src.data[word], src.data[word + 1], src.data[word + 2], src.data[word + 3]),
                      (y & 3) * 4 + (x & 3), (r.mode & 1) != 0);
}
void main()
{
    uint local_pixel = gl_GlobalInvocationID.x;
    if (local_pixel >= r.chunk_pixels) return;
    uint pixel = r.first_pixel + local_pixel;
    if (pixel >= r.pixels) return;
    if (r.mode >= 12) {
        // Two RGB16F texels occupy three words. One invocation owns the pair,
        // including across row/layer boundaries; the last halfword is padded.
        if ((pixel & 1) != 0) return;
        uvec2 a = bc6_texel(pixel), b = uvec2(0);
        bool second = pixel + 1 < r.pixels;
        if (second) b = bc6_texel(pixel + 1);
        uint at = r.destination_word + (pixel / 2) * 3;
        dst.data[at] = a.x;
        dst.data[at + 1] = (a.y & 65535u) | (b.x << 16);
        if (second) dst.data[at + 2] = (b.x >> 16) | (b.y << 16);
        return;
    }
    if (r.mode == 8) {
        // Four RGB texels occupy three storage words. Only their first
        // invocation writes, so odd rows/layers never race at byte boundaries.
        if ((pixel & 3) != 0) return;
        uint count = min(r.pixels - pixel, 4);
        uvec4 colors = uvec4(0);
        for (uint i = 0; i < count; ++i) colors[i] = rgb8_texel(pixel + i);
        uint at = r.destination_word + (pixel / 4) * 3;
        dst.data[at] = colors[0] | (colors[1] << 24);
        if (count >= 2) dst.data[at + 1] = (colors[1] >> 8) | (colors[2] << 16);
        if (count >= 3) dst.data[at + 2] = (colors[2] >> 16) | (colors[3] << 8);
        return;
    }
    uint x = pixel % r.width;
    uint y = (pixel / r.width) % r.height;
    uint layer = pixel / (r.width * r.height);
    uint block = layer * r.layer_blocks + (y / 4) * r.row_blocks + x / 4;
    uint word = r.source_word + block * (r.mode < 2 || r.mode == 4 || r.mode == 5 ? 2 : 4);
    uint within = (y & 3) * 4 + (x & 3);
    if (r.mode >= 10) {
        uvec2 decoded = bc6_rgba16(
            uvec4(src.data[word], src.data[word + 1], src.data[word + 2], src.data[word + 3]), within, r.mode == 11);
        dst.data[r.destination_word + 2 * pixel] = decoded.x;
        dst.data[r.destination_word + 2 * pixel + 1] = decoded.y;
        return;
    }
    if (r.mode == 9) {
        dst.data[r.destination_word + pixel] = bc7_rgba(
            uvec4(src.data[word], src.data[word + 1], src.data[word + 2], src.data[word + 3]), within);
        return;
    }
    if (r.mode >= 4) {
        bool snorm = (r.mode & 1) != 0;
        // BC4 is a single-component R16 image. Pack two texels per storage
        // word, including across row/layer boundaries; never race halfword
        // writes. Dispatch chunks start at multiples of 64 pixels.
        if (r.mode < 6 && (pixel & 1) != 0) return;
        uint red = channel16(word, within, snorm);
        uint other = 0;
        if (r.mode >= 6) other = channel16(word + 2, within, snorm);
        else if (pixel + 1 < r.pixels) {
            uint next = pixel + 1;
            uint nx = next % r.width, ny = (next / r.width) % r.height;
            uint nl = next / (r.width * r.height);
            uint nb = nl * r.layer_blocks + (ny / 4) * r.row_blocks + nx / 4;
            other = channel16(r.source_word + nb * 2, (ny & 3) * 4 + (nx & 3), snorm);
        }
        uint destination = r.mode < 6 ? pixel / 2 : pixel;
        dst.data[r.destination_word + destination] = red | (other << 16);
        return;
    }
    uint color_word = word + (r.mode < 2 ? 0 : 2);
    uint rgba = color_rgba(color_word, within, r.mode);
    uint alpha = rgba >> 24;
    if (r.mode == 2)
        alpha = ((src.data[word + within / 8] >> ((within & 7) * 4)) & 15) * 17;
    else if (r.mode == 3) alpha = alpha3(word, within);
    // sRGB variants retain encoded bytes; image sampling performs the EOTF.
    dst.data[r.destination_word + pixel] = (rgba & 0xffffff) | (alpha << 24);
}
