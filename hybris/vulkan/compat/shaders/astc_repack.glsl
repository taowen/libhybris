/* The block being built. e0 and e1 are the two endpoints per channel, which the ISE writes in the
 * order r0 r1 g0 g1 b0 b1 a0 a1. The weights are packed in the order the ISE writes them, 3 bits
 * each for 8 levels and 2 bits otherwise, plane 0 / plane 1 interleaved per texel for dual plane.
 * No arrays, here or below: Mali keeps any array of more than 8 entries on the stack. */
struct RepackBlock {
   int mode;
   int dual;
   int ccs;
   int cem;
   int ep_range;
   int w_levels;
   ivec4 e0;
   ivec4 e1;
   uvec2 w;
};

/* n <= 8 bits at bit `off` of a 64-bit value, read and replaced. */
uint repack_get64(uvec2 v, int off, int n)
{
   const uint x = off >= 32 ? v.y >> uint(off - 32)
                            : (v.x >> uint(off)) | (off == 0 ? 0u : v.y << uint(32 - off));
   return x & ((1u << uint(n)) - 1u);
}

void repack_set64(inout uvec2 v, int off, int n, uint val)
{
   const uint m = (1u << uint(n)) - 1u;
   val &= m;
   if (off >= 32) {
      v.y = (v.y & ~(m << uint(off - 32))) | (val << uint(off - 32));
   } else {
      v.x = (v.x & ~(m << uint(off))) | (val << uint(off));
      if (off + n > 32)
         v.y = (v.y & ~(m >> uint(32 - off))) | (val >> uint(32 - off));
   }
}

int repack_wbits(int levels)
{
   return levels == 8 ? 3 : 2;
}

int repack_w_get(RepackBlock b, int i)
{
   const int nb = repack_wbits(b.w_levels);
   return int(repack_get64(b.w, i * nb, nb));
}

void repack_w_set(inout RepackBlock b, int i, int v)
{
   const int nb = repack_wbits(b.w_levels);
   repack_set64(b.w, i * nb, nb, uint(v));
}

/* Endpoint k in ISE order. */
int repack_ep(RepackBlock b, int k)
{
   return (k & 1) != 0 ? b.e1[k >> 1] : b.e0[k >> 1];
}

/* n <= 32 bits of v at bit `off` of the block, whose bits there are still 0. */
void repack_put(inout uvec4 o, int off, int n, uint v)
{
   if (n < 32)
      v &= (1u << uint(n)) - 1u;
   const int w = off >> 5;
   const uint s = uint(off & 31);
   const uint lo = v << s;
   const uint hi = s != 0u && int(s) + n > 32 ? v >> (32u - s) : 0u;
   o.x |= w == 0 ? lo : 0u;
   o.y |= w == 1 ? lo : (w == 0 ? hi : 0u);
   o.z |= w == 2 ? lo : (w == 1 ? hi : 0u);
   o.w |= w == 3 ? lo : (w == 2 ? hi : 0u);
}

int repack_ep_unq(int range, int v)
{
   return range == 256 ? v : range == 128 ? ((v << 1) | (v >> 6)) : repack_q48_unq_at(v);
}

int repack_ep_near(int range, int x)
{
   return range == 256 ? x : range == 128 ? repack_q128_near_at(x) : repack_q48_near_at(x);
}

int repack_w_unq(int levels, int v)
{
   if (levels == 3)
      return v * 32;
   int r = levels == 8 ? ((v << 3) | v) : ((v << 4) | (v << 2) | v);
   return r > 32 ? r + 1 : r;
}

/* The endpoint ISE from bit 17: 8 or 7 plain bits per value, or for range 48 a trit and 4 bits,
 * five values per group laid out m0 T[1:0] m1 T[3:2] m2 T[4] m3 T[6:5] m4 T[7] and truncated
 * after the last value. */
void repack_put_ep(inout uvec4 o, RepackBlock b)
{
   const int nep = b.cem == 12 ? 8 : 6;
   if (b.ep_range != 48) {
      const int nb = b.ep_range == 128 ? 7 : 8;
      for (int k = 0; k < nep; k++)
         repack_put(o, 17 + k * nb, nb, uint(repack_ep(b, k)));
      return;
   }
   int pos = 17;
   for (int g = 0; g < nep; g += 5) {
      const int n = min(nep - g, 5);
      int tv = 0;
      for (int i = n - 1; i >= 0; i--)
         tv = tv * 3 + (repack_ep(b, g + i) >> 4);
      const uint T = uint(repack_trit_enc_at(tv));
      for (int i = 0; i < n; i++) {
         /* T bits after value i: from bit 0 2 4 5 7, 2 2 1 2 1 of them. */
         const uint tlo = (0x75420u >> uint(4 * i)) & 15u;
         const uint tn = (0x12122u >> uint(4 * i)) & 15u;
         repack_put(o, pos, 4, uint(repack_ep(b, g + i) & 15));
         repack_put(o, pos + 4, int(tn), (T >> tlo) & ((1u << tn) - 1u));
         pos += 4 + int(tn);
      }
   }
}

/* The weight ISE, bit 0 first, and its length in bits. With 3 levels a weight is a trit alone,
 * so a group of five is the 8 bits of T, truncated to 2 4 5 7 8 bits after 1 2 3 4 5 values. */
int repack_w_stream(RepackBlock b, out uvec2 ws)
{
   const int nw = b.dual != 0 ? 32 : 16;
   if (b.w_levels != 3) {
      const int nbits = nw * repack_wbits(b.w_levels);
      ws = uvec2(b.w.x, nbits >= 64 ? b.w.y : b.w.y & ((1u << uint(nbits - 32)) - 1u));
      return nbits;
   }
   ws = uvec2(0u);
   int pos = 0;
   for (int g = 0; g < nw; g += 5) {
      const int n = min(nw - g, 5);
      int tv = 0;
      for (int i = n - 1; i >= 0; i--)
         tv = tv * 3 + repack_w_get(b, g + i);
      const int nt = int((0x875420u >> uint(4 * n)) & 15u);
      repack_set64(ws, pos, nt, uint(repack_trit_enc_at(tv)));
      pos += nt;
   }
   return pos;
}

uvec4 repack_pack(RepackBlock b)
{
   uvec4 o = uvec4(0u);
   repack_put(o, 0, 11, uint(b.mode));
   repack_put(o, 13, 4, uint(b.cem));
   repack_put_ep(o, b);

   /* The weight stream runs down from bit 127, bit-reversed. */
   uvec2 ws;
   const int wbits = repack_w_stream(b, ws);
   o.w |= bitfieldReverse(ws.x);
   o.z |= bitfieldReverse(ws.y);
   if (b.dual != 0)
      repack_put(o, 128 - wbits - 2, 2, uint(b.ccs));
   return o;
}

int repack_sum3(RepackBlock b, bool hi)
{
   const ivec4 e = hi ? b.e1 : b.e0;
   return repack_ep_unq(b.ep_range, e.r) + repack_ep_unq(b.ep_range, e.g) +
          repack_ep_unq(b.ep_range, e.b);
}

void repack_order(inout RepackBlock b)
{
   if (repack_sum3(b, true) >= repack_sum3(b, false))
      return;
   const ivec4 t = b.e0;
   b.e0 = b.e1;
   b.e1 = t;
   /* Every weight w becomes levels - 1 - w: the complement for 4 and 8 levels, 0 <-> 2 for 3. */
   if (b.w_levels == 3)
      b.w ^= (~b.w & uvec2(0x55555555u)) << 1u;
   else
      b.w = ~b.w;
}

ivec3 repack_565(uint c)
{
   int r = int((c >> 11) & 31u), g = int((c >> 5) & 63u), bl = int(c & 31u);
   return ivec3((r << 3) | (r >> 2), (g << 2) | (g >> 4), (bl << 3) | (bl >> 2));
}

RepackBlock repack_blk_init()
{
   RepackBlock b;
   b.mode = 0;
   b.dual = 0;
   b.ccs = 3;
   b.cem = 8;
   b.ep_range = 256;
   b.w_levels = 4;
   b.e0 = ivec4(0);
   b.e1 = ivec4(0);
   b.w = uvec2(0u);
   return b;
}

/* BC1: a 4-colour block keeps its endpoints and indices; a 3-colour block needs the midpoint, so
 * trits; one with transparent texels also puts alpha on its own plane. `off` is the bit offset of
 * the colour block in blk. The index maps are nibble tables: entry i at bits 4i. */
uvec4 repack_from_bc1(uvec4 blk, int off, bool rgba)
{
   const uint c0 = repack_bits(blk, off, 16), c1 = repack_bits(blk, off + 16, 16);
   const uint idx = repack_bits(blk, off + 32, 32);
   const ivec3 e0 = repack_565(c0), e1 = repack_565(c1);
   RepackBlock b = repack_blk_init();
   const bool uses3 = (idx & (idx >> 1) & 0x55555555u) != 0u;

   if (c0 > c1) {
      b.mode = 0x042;
      for (int t = 0; t < 16; t++)
         repack_w_set(b, t, int((0x2130u >> (4u * ((idx >> uint(2 * t)) & 3u))) & 15u));
   } else if (!(uses3 && rgba)) {
      /* Index 3 of an opaque BC1 is black, off the line: take the palette entry nearest black. */
      const uint black = (e0.r + e0.g + e0.b) <= (e1.r + e1.g + e1.b) ? 0u : 2u;
      const uint map3 = 0x0120u | (black << 12);
      b.mode = 0x051;
      b.w_levels = 3;
      for (int t = 0; t < 16; t++)
         repack_w_set(b, t, int((map3 >> (4u * ((idx >> uint(2 * t)) & 3u))) & 15u));
   } else {
      b.mode = 0x451;
      b.dual = 1;
      b.cem = 12;
      b.ep_range = 128;
      b.w_levels = 3;
      for (int t = 0; t < 16; t++) {
         const uint i = (idx >> uint(2 * t)) & 3u;
         repack_w_set(b, t * 2, int((0x0120u >> (4u * i)) & 15u));
         repack_w_set(b, t * 2 + 1, i == 3u ? 0 : 2);
      }
      b.e0.a = 0;   /* alpha 0 */
      b.e1.a = 127; /* alpha 255 */
   }
   for (int c = 0; c < 3; c++) {
      b.e0[c] = repack_ep_near(b.ep_range, e0[c]);
      b.e1[c] = repack_ep_near(b.ep_range, e1[c]);
   }
   repack_order(b);
   return repack_pack(b);
}

/* BC2/BC3: the colour half (always four colours) on plane 0, the 16 alpha values on plane 1. */
uvec4 repack_from_bc23(uvec4 blk, bool bc3)
{
   int pal[8] = int[](0, 0, 0, 0, 0, 0, 0, 0);
   if (bc3) {
      const int a0 = int(repack_bits(blk, 0, 8)), a1 = int(repack_bits(blk, 8, 8));
      pal[0] = a0;
      pal[1] = a1;
      if (a0 > a1) {
         for (int i = 1; i < 7; i++)
            pal[i + 1] = ((7 - i) * a0 + i * a1 + 3) / 7;
      } else {
         for (int i = 1; i < 5; i++)
            pal[i + 1] = ((5 - i) * a0 + i * a1 + 2) / 5;
         pal[6] = 0;
         pal[7] = 255;
      }
   }

   const uint c0 = repack_bits(blk, 64, 16), c1 = repack_bits(blk, 80, 16), idx = repack_bits(blk, 96, 32);
   const ivec3 e0 = repack_565(c0), e1 = repack_565(c1);
   RepackBlock b = repack_blk_init();
   b.mode = 0x442;
   b.dual = 1;
   b.cem = 12;
   b.ep_range = 48;
   int amin = 255, amax = 0;
   for (int t = 0; t < 16; t++) {
      repack_w_set(b, t * 2, int((0x2130u >> (4u * ((idx >> uint(2 * t)) & 3u))) & 15u));
      const int a = bc3 ? pal[repack_bits(blk, 16 + 3 * t, 3)] : int(repack_bits(blk, 4 * t, 4)) * 17;
      amin = min(amin, a);
      amax = max(amax, a);
   }
   for (int c = 0; c < 3; c++) {
      b.e0[c] = repack_ep_near(48, e0[c]);
      b.e1[c] = repack_ep_near(48, e1[c]);
   }
   b.e0.a = repack_ep_near(48, amin);
   b.e1.a = repack_ep_near(48, amax);
   const int A0 = repack_ep_unq(48, b.e0.a) * 257, A1 = repack_ep_unq(48, b.e1.a) * 257;
   for (int t = 0; t < 16; t++) {
      const int a = bc3 ? pal[repack_bits(blk, 16 + 3 * t, 3)] : int(repack_bits(blk, 4 * t, 4)) * 17;
      int best = 0, bd = 1 << 30;
      for (int q = 0; q < 4; q++) {
         const int w = repack_w_unq(4, q);
         const int d = abs(((A0 * (64 - w) + A1 * w + 32) >> 6) - a * 257);
         if (d < bd) {
            bd = d;
            best = q;
         }
      }
      repack_w_set(b, t * 2 + 1, best);
   }
   repack_order(b);
   return repack_pack(b);
}

